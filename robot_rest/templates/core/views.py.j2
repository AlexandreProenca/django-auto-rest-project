# Gerado por robot_rest a partir do esquema do banco.
# Reescrito a cada execucao: coloque customizacoes em outro modulo.
from rest_framework import viewsets

{% if models %}
from .models import (
{% for model in models %}
    {{ model.name }},
{% endfor %}
)
from .serializers import (
{% for model in models %}
    {{ model.name }}Serializer,
{% endfor %}
)
{% endif %}

{% for model in models %}

class {{ model.name }}ViewSet(viewsets.ModelViewSet):
    # order_by explicito: paginar queryset sem ordenacao devolve paginas
    # inconsistentes (UnorderedObjectListWarning do DRF).
    queryset = {{ model.name }}.objects.all().order_by("pk")
    serializer_class = {{ model.name }}Serializer

{% endfor %}
