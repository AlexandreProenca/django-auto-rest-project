# Configuracao local do projeto {{ project_name }}.
# NAO versione este arquivo: ele contem a senha do banco e a SECRET_KEY.
SECRET_KEY={{ secret_key | envquote }}
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE={{ database.ENGINE }}
DB_NAME={{ database.NAME | envquote }}
DB_USER={{ database.USER | envquote }}
DB_PASSWORD={{ database.PASSWORD | envquote }}
DB_HOST={{ database.HOST | envquote }}
DB_PORT={{ database.PORT }}

CORS_ALLOWED_ORIGINS=
