class TestGeneratedRoutes(TestCase):
    """Uma rota por modelo descoberto no banco."""

{% for model in models %}
    def test_{{ model.basename }}_list_route_exists(self):
        self.assertTrue(reverse("{{ model.basename }}-list"))

    def test_{{ model.basename }}_list_requires_authentication(self):
        response = APIClient().get(reverse("{{ model.basename }}-list"))
        self.assertIn(response.status_code, (401, 403))

