{% raw %}{% extends "base.html" %}
{% block title %}Nova senha{% endblock %}
{% block heading %}Defina a nova senha{% endblock %}
{% block content %}
  {% if validlink %}
    <form method="post">{% csrf_token %}
      {{ form.as_p }}
      <button type="submit">Salvar senha</button>
    </form>
  {% else %}
    <p>Este link de recuperacao ja foi usado ou expirou.</p>
    <p><a href="{% url 'password_reset' %}">Pedir um novo link</a></p>
  {% endif %}
{% endblock %}{% endraw %}
